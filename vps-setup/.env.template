# Guardian Relay v2 - Environment Config
# Copy to .env and fill ALL values before deploying

MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=guardian
MQTT_PASS=CHANGE_ME_STRONG_PASSWORD

# Generate with: python3 -c "import base64,os; print(base64.b32encode(os.urandom(20)).decode())"
TOTP_SECRET=YOUR_BASE32_TOTP_SECRET

# Master password for dashboard login
MASTER_PASSWORD=CHANGE_ME_MASTER_PASSWORD

# Nuke passphrase - Step 1 of 3-step nuke confirmation
NUKE_PASSPHRASE=CHANGE_ME_NUKE_PASSPHRASE

# ntfy.sh topic - treat like a password, e.g. guardian-abc123xyz
NTFY_TOPIC=guardian-CHANGE_ME

# Command TTL in seconds (default 300 = 5 min)
COMMAND_TTL=300

# Nuke countdown in seconds (default 600 = 10 min)
NUKE_COUNTDOWN=600

# CORS: set to the exact URL where you serve dashboard.html
# e.g. https://dashboard.yourdomain.com or http://localhost:8080
# Leave empty ONLY for local dev (disables CORS enforcement)
DASHBOARD_ORIGIN=https://YOUR_DASHBOARD_URL_HERE
